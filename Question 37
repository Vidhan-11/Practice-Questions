#include<stdio.h>
int main(){
    int num1,num2,LCM = 1,max;
    printf("Number 1: \n");
    scanf("%d",&num1);
    printf("Number 2: \n");
    scanf("%d",&num2);
    if(num1>num2){
        max = num1;
    }
    for(int i = 1;i<max;i++){
        if(num1 % i == 0 && num2 % i == 0){
            LCM *= i;
        }
        if(num1 % i == 0 && !(num2 % i == 0)){
            LCM *= i;
        }
        if(!(num1 % i == 0) && num2 % i == 0){
            LCM *= i;
        }
    }
    printf("LCM : %d",LCM);
    

    return 0;
}
