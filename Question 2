#include<stdio.h>
#define MAX 10
void sort(int* n,int m);
int main(){
	int k,l;
	int num1[MAX],num2[MAX];
	printf("Input of max 10 numbers is possible.\n");
	printf("Enter 0 to break loop.\n");
	printf("This is for first array\n");
	for(int n = 0;n < 10;n++){
		scanf("%d",&num1[n]);
		printf("\n");
		if(num1[n]==0){
			break;
		}k++;
	}
	printf("This is for second array\n");
	for(int n = 0;n < 10;n++){
		scanf("%d",&num2[n]);
		printf("\n");
		if(num2[n]==0){
			break;
		}l++;
	}
	sort(num1,k);
	sort(num2,l);
	if((l+k)/2 > l){
		printf("Median value of both arrays is: %d",num2[(k - l+k)/2]);
	}else{
		printf("Median value of both arrays if :%d",num1[(l+k)/2]);
	}
	return 0;
}
void sort(int* n,int m){
	for(int i = 0;i<m;i++){
		for(int j= 0;j<m;j++){
			if(n[j]<n[j+1]){
				n[j] = n[j]^n[j+1];
				n[j+1] = n[j]^n[j+1];
				n[j] = n[j]^n[j+1];
			}
		}	
	}
	printf("Your array is sorted\n");
}
