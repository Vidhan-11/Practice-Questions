void add_account(){
    struct Account new;
    strcpy(new.name,"USER");
    FILE* file = fopen("records.dat","ab");
    printf("\nEnter name of new user : ");
    char name[20];
    fgets(name,20,stdin);
    name[strcspn(name,"\n")] = '\0';
    strcpy(new.name,name);
    printf("Enter account number : ");
    scanf("%d",&new.acc_number);
    printf("\nEnter your account password : ");
    scanf("%d",&new.password);
    printf("\nEnter your initial balance : ");
    scanf("%f",&new.balance);
    fwrite(&new,sizeof(new),1,file);
    printf("\n--------YOUR ACCOUNT HAS BEEN CREATED SUCCESSFULLY ---------\n");
    fclose(file);
    return ;
}
