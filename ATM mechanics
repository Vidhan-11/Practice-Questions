void widthraw(){
    FILE* file = fopen("records.dat","r+b");
    if(file == NULL){
        printf("\nThe file could not be opened.");
        printf("\nThanks for visiting.\n");
        exit(EXIT_FAILURE);
    }
    struct Account info;
    int flag = 0;
    printf("\nEnter your account number : ");
    int n;
    scanf("%d",&n);
    while(fread(&info,sizeof(info),1,file) > 0){
        if(n == info.acc_number){
            flag++;
            int pass;
            printf("\nEnter password : ");
            scanf("%d",&pass);
            if(pass == info.password){
                float amount;
                printf("\nHow much money would you like to widhtraw ? ");
                scanf("%f",&amount);
                if(amount > info.balance){
                    printf("\nAccount balance is insufficient.");
                    fclose(file);
                    break;
                }else if(amount <= 0){
                    printf("\nNegative widhtraw is not allowed.");
                    fclose(file);
                    break;
                }else{
                    printf("\nSuccessfully widthrawn !\nYour new account balance is : %.2f\nThanks for visiting.",info.balance - amount);
                    fseek(file,-(long)sizeof(info),SEEK_CUR);
                    struct Account changer;
                    strcpy(changer.name,info.name);                   
                    changer.password = info.password;
                    changer.acc_number = info.acc_number;
                    changer.balance = info.balance - amount;
                    fwrite(&changer,sizeof(changer),1,file);
                    fclose(file);
                    break;
                }
            }else{
                printf("\nIncorrect password!");
                fclose(file);
                break;
            }
        }else{
            continue;
        }
    }
    if(flag == 0){
        printf("\nYou don't own an account in this bank.");
        fclose(file);
    }
    
    return ;
}
void deposit(){
    FILE* file = fopen("records.dat","r+b");
    if(file == NULL){
        printf("\nError in opening file.");
        printf("\nThanks for visiting.");
        exit(EXIT_FAILURE);
    }
    struct Account info;
    int flag = 0;
    printf("\nEnter your account number : ");
    int n;
    scanf("%d",&n);
    while(fread(&info,sizeof(info),1,file)>0){
        if(n == info.acc_number){
            flag++;
            printf("\nEnter account password : ");
            int pass;
            scanf("%d",&pass);
            if(pass == info.password){
                printf("\nEnter amount to be deposited : ");
                float amount;
                do{
                scanf("%f",&amount);
                }while(amount < 0);
                struct Account changer;
                strcpy(changer.name,info.name);
                changer.balance = amount + info.balance;
                printf("\nYour account balance is : %.2f",changer.balance);
                changer.password = info.password;
                changer.acc_number = info.acc_number;
                fseek(file,-(long)sizeof(changer),SEEK_CUR);
                fwrite(&changer,sizeof(changer),1,file);
                printf("\nThanks for visiting.");
                fclose(file);
                break;
            }else{
                printf("\nIncorrect password.");
                fclose(file);
                break;
            }
        }else{
            continue;
        }
    }
    if(flag == 0){
        printf("\nYou don't own an account in this bank.");
        fclose(file);
    }
    return;
}
