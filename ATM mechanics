void widthraw(){
    struct Account info;
    FILE* file = fopen("records.dat","r+");
    printf("Enter your account number : ");
    scanf("%d",&info.acc_number);
    int num,flag = 0;
    while(fread(&num,sizeof(info.acc_number),1,file) > 0){
        if(num == info.acc_number){
            printf("\nEnter password : ");
            int pas;
            scanf("%d",&pas);
            fread(&info.password,sizeof(info.password),1,file);
            if(pas != info.password){
                printf("\nWrong password..");
                fclose(file);
                break;
            }else{
                printf("\nEnter desired amount : ");
                int amount;
                scanf("%d",&amount);
                fread(&info.balance,sizeof(info.balance),1,file);
                if(amount > info.balance){
                    printf("\nInfuccient amount in account..\n");
                    fclose(file);
                    break;
                }else{
                    printf("\nAmount widthrawn successfully !");
                    info.balance -= amount ;
                    fseek(file,-(long)sizeof(info.balance),SEEK_CUR);
                    fwrite(&info.balance,sizeof(info.balance),1,file);
                    printf("\nYour new account balance is : %.2f\nThanks for visiting.\n",info.balance);
                    fclose(file);
                    break;
                }

            }
        }     
    }
    if(flag == 0){
    printf("\nYour account does not exist.\n");
    fclose(file);
    }
    return ;
}
void deposit(){
    FILE* file = fopen("records.dat","r+");
    struct Account info;
    int n,flag = 0;
    printf("\nEnter your account number : ");
    scanf("%d",&n);
    while(fread(&info.acc_number,sizeof(info.acc_number),1,file) > 0){
        if(n == info.acc_number){
            flag++;
            printf("\nEnter account password : ");
            int pas;
            scanf("%d",&pas);
            fread(&info.password,sizeof(info.password),1,file);
            if(pas != info.password){
                printf("\nInvalid password !\n");
                fclose(file);
                break;
            }else{
                printf("\nEnter the amount to be deposited : ");
                int amount;
                scanf("%d",&amount);
                fread(&info.balance,sizeof(info.balance),1,file);
                info.balance += amount;
                fseek(file,-(long)sizeof(info.balance),SEEK_CUR);
                fwrite(&info.balance,sizeof(info.balance),1,file);
                printf("\nYour new account balance is : %.2f\nThanks for visiting!\n",info.balance);
                fclose(file);
                break;
            }
        }
    }
    if(flag == 0){
    printf("\nYour account does not exist\n");
    fclose(file);
    }
    return ;
}
