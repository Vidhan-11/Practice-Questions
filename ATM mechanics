void add_account(){
    FILE* file = fopen("records.dat","a");
    printf("\nEnter name of new user : ");
    struct Account new;
    fgets(new.name,20,stdin);
    fwrite(&new.name,sizeof(new.name),1,file);
    printf("Enter account number : ");
    scanf("%d",&new.acc_number);
    fwrite(&new.acc_number,sizeof(new.acc_number),1,file);
    printf("\nEnter your account password : ");
    scanf("%d",&new.password);
    fwrite(&new.password,sizeof(new.password),1,file);
    printf("\nEnter your initial balance : ");
    scanf("%f",&new.balance);
    fwrite(&new.balance,sizeof(new.balance),1,file);
    printf("\n--------YOUR ACCOUNT HAS BEEN CREATED SUCCESSFULLY ---------\n");
    fclose(file);
    return ;
}
