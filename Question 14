#include<iostream>
using namespace std;
int profit(vector<int> prices){
	int best_buy = prices[0],max_profit = 0;
	for(int i = 1;i < prices.size();i++){
		max_profit = max(max_profit,prices[i] - best_buy);
		best_buy = min(best_buy,prices[i - 1]);
	}
	return max_profit;
}
int main(){
	vector<int>rate =  {4,7,9,2,1,3};
	cout<<profit(rate);
	return 0;
}
