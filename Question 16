#include<iostream
#include<vector>
using namespace std;
int binary_search(vector<int> arr,int target){
	int st = 0;end = arr.size();
	while(st<=end){
		int mid = (st + end)/2;
		if(target > arr[mid]){
			st = mid +1;
		}else if(target < arr[mid]){
			end = mid -1;
		}else{
			return mid;
		}
	}
	return -1;
}

int main(){
	vector<int> arr1 = {-1,0,3,4,5,9,12};
	int tar1 = 5;
	cout << binary_search(arr1,tar1)<<endl;
	vector<int> arr2 = {-1,0,3,5,9,12};
	int tar2 = 0;
	cout<< binary_search(arr2,tar2)<<endl;
	return 0;
}
